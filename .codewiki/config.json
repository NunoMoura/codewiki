{
	"project": "codewiki",
	"runtime": {
		"maxWorkers": 1,
		"worktreeIsolation": "none",
		"worktreeSetupCommands": [],
		"automation": "manual",
		"agency": "assist",
		"budgets": {
			"maxIterations": 1
		},
		"approval": {
			"cadence": "per_iteration",
			"destructiveAction": "ask",
			"riskEscalation": "ask",
			"requireExpectedBytes": true
		},
		"stopConditions": [
			"semantic_decision",
			"risk_escalation",
			"destructive_action"
		]
	},
	"retention": {
		"enabled": true,
		"archiveRefPrefix": "refs/codewiki/archive/",
		"hotTraceLimit": 20,
		"requireCloseRecord": true,
		"hydrateOnDemand": true
	},
	"hosts": {
		"pi": {
			"enabled": false
		},
		"mcp": {
			"enabled": false
		}
	}
}
