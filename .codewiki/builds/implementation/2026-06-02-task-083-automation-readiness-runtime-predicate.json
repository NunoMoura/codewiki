    "id": "TASK-083",
    "title": "Add automation-readiness runtime predicate",
    "status": "in_progress",
    "priority": "high",
    "kind": "agent-workflow",
    "summary": "Implement graph/runtime automation-readiness status so agents and daemon flows know when work is runnable, blocked, retryable, or promotable without inferring from chat.",
    "spec_paths": [
      ".codewiki/kb/system/agency.md",
      ".codewiki/kb/system/runtime.md"
    ],
    "code_paths": [
      "src/agency/planning.ts",
      "src/agency/auto-pickup.ts",
      "src/agency/config.ts",
      "src/runtime/runner.ts",
      "src/runtime/types.ts",
      "src/roadmap/selection.ts",
      "src/roadmap/task-boundary.ts",
