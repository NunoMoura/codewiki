{
	"name": "@nunomoura/codewiki",
	"version": "0.3.0",
	"description": "Project-scoped development control plane with Change Traces, four semantic Loops, project Check Packs, Gate Reports, canonical Knowledge, and bounded execution adapters.",
	"keywords": [
		"documentation",
		"wiki",
		"llm",
		"agent",
		"okf",
		"pi-package"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./runtime": {
			"types": "./dist/runtime/index.d.ts",
			"import": "./dist/runtime/index.js"
		},
		"./pi-sdk": {
			"types": "./dist/execution/pi/sdk-semantic-session.d.ts",
			"import": "./dist/execution/pi/sdk-semantic-session.js"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/clients/app/assets','dist/clients/app/assets',{recursive:true})\"",
		"dashboard:dev": "node --experimental-strip-types scripts/dashboard-dev.mjs",
		"prepack": "npm run build",
		"test": "npm run typecheck && npm run test:smoke",
		"test:smoke": "node --experimental-strip-types --test ./tests/scaffold-core.test.mjs ./tests/benchmarks/*.test.mjs ./tests/integration/*.test.mjs ./tests/changes/*.test.mjs ./tests/changes/trace/*.test.mjs ./tests/alignment/*.test.mjs ./tests/clients/**/*.test.mjs ./tests/server/**/*.test.mjs ./tests/protocol/*.test.mjs ./tests/evidence/*.test.mjs ./tests/checks/*.test.mjs ./tests/execution/*.test.mjs ./tests/execution/checks/*.test.mjs ./tests/execution/pi/*.test.mjs ./tests/execution/security/*.test.mjs ./tests/execution/review/*.test.mjs ./tests/execution/runner-bundles/*.test.mjs ./tests/execution/supervisor/*.test.mjs ./tests/checks/quality/*.test.mjs ./tests/loops/*.test.mjs ./tests/loops/decision/*.test.mjs ./tests/loops/planning/*.test.mjs ./tests/loops/implementation/*.test.mjs ./tests/knowledge/*.test.mjs ./tests/project/*.test.mjs ./tests/work-state/*.test.mjs ./tests/runtime/*.test.mjs ./tests/runtime/commands/*.test.mjs ./tests/runtime/workbenches/*.test.mjs ./tests/runtime/workers/*.test.mjs ./tests/runtime/integration/*.test.mjs ./tests/runtime/lifecycle/*.test.mjs ./tests/runtime/admission/*.test.mjs ./tests/runtime/coordinator/*.test.mjs ./tests/runtime/effects/*.test.mjs ./tests/runtime/persistence/*.test.mjs ./tests/runtime/queries/*.test.mjs",
		"test:features": "node --experimental-strip-types --test ./tests/benchmarks/*.test.mjs ./tests/integration/*.test.mjs ./tests/changes/*.test.mjs ./tests/changes/trace/*.test.mjs ./tests/alignment/*.test.mjs ./tests/clients/**/*.test.mjs ./tests/server/**/*.test.mjs ./tests/protocol/*.test.mjs ./tests/evidence/*.test.mjs ./tests/checks/*.test.mjs ./tests/execution/*.test.mjs ./tests/execution/checks/*.test.mjs ./tests/execution/pi/*.test.mjs ./tests/execution/security/*.test.mjs ./tests/execution/review/*.test.mjs ./tests/execution/runner-bundles/*.test.mjs ./tests/execution/supervisor/*.test.mjs ./tests/checks/quality/*.test.mjs ./tests/loops/*.test.mjs ./tests/loops/decision/*.test.mjs ./tests/loops/planning/*.test.mjs ./tests/loops/implementation/*.test.mjs ./tests/knowledge/*.test.mjs ./tests/project/*.test.mjs ./tests/work-state/*.test.mjs ./tests/runtime/*.test.mjs ./tests/runtime/commands/*.test.mjs ./tests/runtime/workbenches/*.test.mjs ./tests/runtime/workers/*.test.mjs ./tests/runtime/integration/*.test.mjs ./tests/runtime/lifecycle/*.test.mjs ./tests/runtime/admission/*.test.mjs ./tests/runtime/coordinator/*.test.mjs ./tests/runtime/effects/*.test.mjs ./tests/runtime/persistence/*.test.mjs ./tests/runtime/queries/*.test.mjs",
		"test:benchmarks": "node --experimental-strip-types --test ./tests/benchmarks/*.test.mjs",
		"test:pack": "npm pack --dry-run && node tests/runtime/package-install-smoke.mjs",
		"test:coordinator": "node --experimental-strip-types --test tests/runtime/project-coordinator.test.mjs tests/runtime/project-coordinator-events.test.mjs tests/runtime/implementation-worker-artifacts.test.mjs tests/runtime/workers/dispatch.test.mjs tests/runtime/integration/worker.test.mjs tests/runtime/project-branch-merge.test.mjs tests/runtime/project-branch-push.test.mjs tests/runtime/product-publication.test.mjs tests/runtime/product-release.test.mjs tests/runtime/workers/jobs.test.mjs tests/execution/pi/process-worker-adapter.test.mjs tests/runtime/workbenches/container.test.mjs tests/runtime/project-coordinator-service.test.mjs tests/server/app/coordinator-client.test.mjs tests/runtime/project-coordinator-process.test.mjs tests/runtime/coordinator/reactions.test.mjs tests/clients/pi/project-service-client.test.mjs tests/execution/pi/coordinator-daemon.test.mjs tests/runtime/coordinator/reactor.test.mjs tests/runtime/coordinator/executor.test.mjs",
		"test:pi-install": "node tests/clients/pi/install-smoke.mjs",
		"test:pi-rpc": "node tests/clients/pi/rpc-smoke.mjs",
		"test:pi-multiprocess": "node --experimental-strip-types tests/clients/pi/multiprocess-coordinator-smoke.mjs",
		"test:pi-sdk": "node --experimental-strip-types --test tests/execution/pi/sdk-semantic-session.test.mjs",
		"test:pi-sdk-package": "node tests/execution/pi/sdk-package-smoke.mjs",
		"test:project-local-install": "node tests/runtime/project-local-install-smoke.mjs",
		"test:external-lifecycle": "node tests/runtime/external-package-lifecycle-smoke.mjs",
		"test:external-failures": "node tests/runtime/external-package-failures-smoke.mjs",
		"test:readiness": "node --experimental-strip-types --test tests/runtime/readiness-checklist.test.mjs",
		"audit:codewiki": "npm test && npm run test:pack && npm run test:pi-install && npm run test:pi-rpc && npm run test:pi-multiprocess && npm run test:pi-sdk && npm run test:pi-sdk-package && npm run test:project-local-install && npm run test:external-lifecycle && npm run test:external-failures && npm run test:readiness && npm audit --omit=dev && git diff --check",
		"typecheck": "tsc --noEmit"
	},
	"license": "MIT",
	"author": "Nuno Moura",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NunoMoura/codewiki.git"
	},
	"bugs": {
		"url": "https://github.com/NunoMoura/codewiki/issues"
	},
	"homepage": "https://github.com/NunoMoura/codewiki#readme",
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"package.json"
	],
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.81.1",
		"@types/node": "*",
		"typebox": "^1.3.6",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=20.6.0"
	},
	"knip": {
		"entry": [
			"src/index.ts",
			"src/pi-extension.ts",
			"src/execution/pi/coordinator-daemon.ts",
			"src/execution/pi/sdk-semantic-session.ts",
			"src/runtime/index.ts",
			"src/clients/pi/rendering/command-renderers.ts",
			"tests/**/*.mjs"
		],
		"project": [
			"src/**/*.ts",
			"benchmarks/**/*.ts",
			"tests/**/*.mjs"
		],
		"ignoreDependencies": []
	},
	"pi": {
		"extensions": [
			"dist/pi-extension.js"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.80.10 <0.82.0",
		"typebox": "*"
	},
	"dependencies": {
		"fast-xml-parser": "^5.10.1",
		"fast-xml-validator": "^1.4.1",
		"yaml": "^2.9.0"
	},
	"private": true,
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	}
}
