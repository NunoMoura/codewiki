{
	"name": "codewiki",
	"version": "0.1.2",
	"description": "Source-first CodeWiki package scaffold; Pi extension loading is disabled while the project is rebuilt.",
	"keywords": [
		"documentation",
		"wiki",
		"llm",
		"agent"
	],
	"type": "module",
	"scripts": {
		"test": "npm run typecheck && npm run test:smoke",
		"test:smoke": "node --experimental-strip-types --test ./tests/scaffold.test.mjs ./tests/decision/*.test.mjs ./tests/planning/*.test.mjs ./tests/implementation/*.test.mjs ./tests/traces/*.test.mjs",
		"test:features": "node --experimental-strip-types --test ./tests/decision/*.test.mjs ./tests/planning/*.test.mjs ./tests/implementation/*.test.mjs ./tests/traces/*.test.mjs",
		"test:pack": "npm pack --dry-run",
		"typecheck": "tsc --noEmit"
	},
	"license": "MIT",
	"author": "Nuno Moura",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NunoMoura/codewiki.git"
	},
	"bugs": {
		"url": "https://github.com/NunoMoura/codewiki/issues"
	},
	"homepage": "https://github.com/NunoMoura/codewiki#readme",
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"package.json"
	],
	"devDependencies": {
		"@types/node": "*",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=20.6.0"
	},
	"dependencies": {
		"js-yaml": "^4.1.1"
	},
	"knip": {
		"entry": [
			"src/index.ts",
			"src/api/index.ts",
			"tests/**/*.mjs"
		],
		"project": [
			"src/**/*.ts",
			"tests/**/*.mjs"
		],
		"ignoreDependencies": []
	}
}
