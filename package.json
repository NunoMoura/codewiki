{
	"name": "@nunomoura/codewiki",
	"version": "0.3.0",
	"description": "Project-scoped development control plane with Change Traces, global Planning, parallel Implementation, canonical Knowledge, and Pi execution adapters.",
	"keywords": [
		"documentation",
		"wiki",
		"llm",
		"agent",
		"okf",
		"pi-package"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./coordinator": {
			"types": "./dist/harnesses/coordinator-entrypoint.d.ts",
			"import": "./dist/harnesses/coordinator-entrypoint.js"
		},
		"./pi-sdk": {
			"types": "./dist/pi/sdk-semantic-session.d.ts",
			"import": "./dist/pi/sdk-semantic-session.js"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/dashboard/assets','dist/dashboard/assets',{recursive:true})\"",
		"dashboard:dev": "node --experimental-strip-types scripts/dashboard-dev.mjs",
		"prepack": "npm run build",
		"test": "npm run typecheck && npm run test:smoke",
		"test:smoke": "node --experimental-strip-types --test ./tests/scaffold-core.test.mjs ./tests/benchmarks/*.test.mjs ./tests/integration/*.test.mjs ./tests/changes/*.test.mjs ./tests/dashboard/*.test.mjs ./tests/evidence/*.test.mjs ./tests/verification/*.test.mjs ./tests/verification/custom-checks/*.test.mjs ./tests/loops/*.test.mjs ./tests/lab/*.test.mjs ./tests/decision/*.test.mjs ./tests/planning/*.test.mjs ./tests/implementation/*.test.mjs ./tests/knowledge/*.test.mjs ./tests/project/*.test.mjs ./tests/traces/*.test.mjs ./tests/views/*.test.mjs ./tests/work-state/*.test.mjs ./tests/runtime/*.test.mjs ./tests/runtime/workers/*.test.mjs ./tests/runtime/integration/*.test.mjs ./tests/runtime/admission/*.test.mjs ./tests/runtime/coordinator/*.test.mjs ./tests/runtime/effects/*.test.mjs",
		"test:features": "node --experimental-strip-types --test ./tests/benchmarks/*.test.mjs ./tests/integration/*.test.mjs ./tests/changes/*.test.mjs ./tests/dashboard/*.test.mjs ./tests/evidence/*.test.mjs ./tests/verification/*.test.mjs ./tests/verification/custom-checks/*.test.mjs ./tests/loops/*.test.mjs ./tests/lab/*.test.mjs ./tests/decision/*.test.mjs ./tests/planning/*.test.mjs ./tests/implementation/*.test.mjs ./tests/knowledge/*.test.mjs ./tests/project/*.test.mjs ./tests/traces/*.test.mjs ./tests/views/*.test.mjs ./tests/work-state/*.test.mjs ./tests/runtime/*.test.mjs ./tests/runtime/workers/*.test.mjs ./tests/runtime/integration/*.test.mjs ./tests/runtime/admission/*.test.mjs ./tests/runtime/coordinator/*.test.mjs ./tests/runtime/effects/*.test.mjs",
		"test:benchmarks": "node --experimental-strip-types --test ./tests/benchmarks/*.test.mjs",
		"test:pack": "npm pack --dry-run && node tests/runtime/package-install-smoke.mjs",
		"test:coordinator": "node --experimental-strip-types --test tests/runtime/project-coordinator.test.mjs tests/runtime/project-coordinator-events.test.mjs tests/runtime/implementation-worker-artifacts.test.mjs tests/runtime/workers/dispatch.test.mjs tests/runtime/integration/worker.test.mjs tests/runtime/project-branch-merge.test.mjs tests/runtime/project-branch-push.test.mjs tests/runtime/product-publication.test.mjs tests/runtime/product-release.test.mjs tests/runtime/workers/jobs.test.mjs tests/runtime/process-worker-adapter.test.mjs tests/runtime/container-worker-adapter.test.mjs tests/runtime/project-coordinator-service.test.mjs tests/runtime/dashboard-coordinator-client.test.mjs tests/runtime/project-coordinator-process.test.mjs tests/runtime/coordinator/reactions.test.mjs tests/runtime/pi-project-service-client.test.mjs tests/runtime/pi-project-coordinator-daemon.test.mjs tests/runtime/coordinator/reactor.test.mjs tests/runtime/coordinator/executor.test.mjs",
		"test:pi-install": "node tests/runtime/pi-install-smoke.mjs",
		"test:pi-rpc": "node tests/runtime/pi-rpc-smoke.mjs",
		"test:pi-multiprocess": "node --experimental-strip-types tests/runtime/pi-multiprocess-coordinator-smoke.mjs",
		"test:pi-mutation": "node --experimental-strip-types tests/runtime/pi-tool-mutation-smoke.mjs",
		"test:pi-sdk": "node --experimental-strip-types --test tests/runtime/pi-sdk-semantic-session.test.mjs",
		"test:pi-sdk-package": "node tests/runtime/pi-sdk-package-smoke.mjs",
		"test:project-local-install": "node tests/runtime/project-local-install-smoke.mjs",
		"test:external-lifecycle": "node tests/runtime/external-package-lifecycle-smoke.mjs",
		"test:external-failures": "node tests/runtime/external-package-failures-smoke.mjs",
		"test:readiness": "node --experimental-strip-types --test tests/runtime/readiness-checklist.test.mjs",
		"test:self-dogfood-candidate": "npm run audit:codewiki && npm run lab:gate && npm run lab:pipeline -- --gate",
		"self-dogfood:baseline:create": "node --experimental-strip-types scripts/create-self-dogfood-baseline.mjs",
		"self-dogfood:baseline:verify": "node --experimental-strip-types scripts/verify-self-dogfood-baseline.mjs",
		"self-dogfood:controller:install": "node --experimental-strip-types scripts/install-self-dogfood-controller.mjs",
		"test:self-dogfood-shadow": "node --experimental-strip-types scripts/run-self-dogfood-shadow.mjs",
		"test:self-dogfood-ready": "npm run self-dogfood:baseline:verify -- --require-clean && npm run test:self-dogfood-candidate && npm run test:self-dogfood-shadow",
		"lab": "node --experimental-strip-types lab/runner/score.ts",
		"lab:gate": "node --experimental-strip-types lab/runner/score.ts --gate",
		"lab:holdout": "node --experimental-strip-types lab/runner/holdout-score.ts",
		"lab:forge": "node --experimental-strip-types lab/runner/trace-forge.ts",
		"lab:pipeline": "node --experimental-strip-types lab/pipeline/score.ts",
		"lab:graph": "node --experimental-strip-types lab/runner/graph.ts",
		"lab:objective": "node --experimental-strip-types lab/runner/objective.ts",
		"lab:promotion": "node --experimental-strip-types lab/runner/promotion.ts",
		"lab:judge-calibration": "node --experimental-strip-types lab/runner/judge-calibration.ts",
		"lab:security-calibration": "node --experimental-strip-types lab/runner/security-calibration.ts",
		"lab:judge-smoke": "node --experimental-strip-types lab/runner/judge-smoke.ts",
		"lab:sealed-template": "node --experimental-strip-types lab/runner/sealed-template.ts",
		"lab:sealed-check": "node --experimental-strip-types lab/runner/sealed-check.ts",
		"lab:experiment": "node --experimental-strip-types lab/runner/experiment-runner.ts",
		"lab:auto-experiment": "node --experimental-strip-types lab/runner/experiment-budget.ts",
		"audit:codewiki": "npm test && npm run test:coordinator && npm run test:pack && npm run test:pi-install && npm run test:pi-rpc && npm run test:pi-multiprocess && npm run test:pi-mutation && npm run test:pi-sdk && npm run test:pi-sdk-package && npm run test:project-local-install && npm run test:external-lifecycle && npm run test:external-failures && npm run test:readiness && npm audit --omit=dev && git diff --check",
		"typecheck": "tsc --noEmit"
	},
	"license": "MIT",
	"author": "Nuno Moura",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NunoMoura/codewiki.git"
	},
	"bugs": {
		"url": "https://github.com/NunoMoura/codewiki/issues"
	},
	"homepage": "https://github.com/NunoMoura/codewiki#readme",
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"package.json"
	],
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.81.1",
		"@types/node": "*",
		"typebox": "^1.3.6",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=20.6.0"
	},
	"knip": {
		"entry": [
			"src/index.ts",
			"src/benchmarks/*.ts",
			"src/api/index.ts",
			"src/pi/extension.ts",
			"src/pi/sdk-semantic-session.ts",
			"src/harnesses/coordinator-entrypoint.ts",
			"src/pi/rendering/command-renderers.ts",
			"tests/**/*.mjs"
		],
		"project": [
			"src/**/*.ts",
			"tests/**/*.mjs"
		],
		"ignoreDependencies": []
	},
	"pi": {
		"extensions": [
			"dist/pi/extension.js"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.80.10 <0.82.0",
		"typebox": "*"
	},
	"dependencies": {
		"fast-xml-parser": "^5.10.1",
		"fast-xml-validator": "^1.4.1",
		"yaml": "^2.9.0"
	},
	"private": true,
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	}
}
