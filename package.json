{
	"name": "codewiki",
	"version": "0.1.2",
	"description": "Source-first CodeWiki package scaffold for Pi-native tools and commands.",
	"keywords": [
		"documentation",
		"wiki",
		"llm",
		"agent",
		"pi-package"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
		"prepack": "npm run build",
		"test": "npm run typecheck && npm run test:smoke",
		"test:smoke": "node --experimental-strip-types --test ./tests/scaffold.test.mjs ./tests/decision/*.test.mjs ./tests/planning/*.test.mjs ./tests/implementation/*.test.mjs ./tests/knowledge/*.test.mjs ./tests/project/*.test.mjs ./tests/traces/*.test.mjs ./tests/views/*.test.mjs ./tests/runtime/*.test.mjs",
		"test:features": "node --experimental-strip-types --test ./tests/decision/*.test.mjs ./tests/planning/*.test.mjs ./tests/implementation/*.test.mjs ./tests/knowledge/*.test.mjs ./tests/project/*.test.mjs ./tests/traces/*.test.mjs ./tests/views/*.test.mjs ./tests/runtime/*.test.mjs",
		"test:pack": "npm pack --dry-run && node tests/runtime/package-install-smoke.mjs",
		"test:pi-install": "node tests/runtime/pi-install-smoke.mjs",
		"test:pi-rpc": "node tests/runtime/pi-rpc-smoke.mjs",
		"test:readiness": "node --experimental-strip-types --test tests/runtime/readiness-checklist.test.mjs",
		"typecheck": "tsc --noEmit"
	},
	"license": "MIT",
	"author": "Nuno Moura",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NunoMoura/codewiki.git"
	},
	"bugs": {
		"url": "https://github.com/NunoMoura/codewiki/issues"
	},
	"homepage": "https://github.com/NunoMoura/codewiki#readme",
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"package.json"
	],
	"devDependencies": {
		"@types/node": "*",
		"typebox": "^1.2.14",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=20.6.0"
	},
	"knip": {
		"entry": [
			"src/index.ts",
			"src/api/index.ts",
			"src/pi/extension.ts",
			"src/pi/rendering/tool-renderers.ts",
			"src/pi/rendering/command-renderers.ts",
			"tests/**/*.mjs"
		],
		"project": [
			"src/**/*.ts",
			"tests/**/*.mjs"
		],
		"ignoreDependencies": []
	},
	"pi": {
		"extensions": [
			"dist/pi/extension.js"
		]
	},
	"peerDependencies": {
		"typebox": "*"
	},
	"dependencies": {
		"yaml": "^2.9.0"
	}
}
